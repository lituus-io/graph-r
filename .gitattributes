# Text is normalised to LF in the repository; fixtures are byte-exact on
# every platform (golden tests compare them byte for byte), and files read by
# scripts keep LF even in Windows checkouts.
* text=auto
tests/fixtures/** -text
*.lnkr binary
*.sh text eol=lf
.github/siblings text eol=lf
